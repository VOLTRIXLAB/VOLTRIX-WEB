<header class="vx-header section--dark">
  <div class="page-width vx-header__inner">
    <a href="{{ routes.root_url }}" class="vx-header__logo">
      <img src="{{ 'logo-voltrix.png' | asset_url }}" alt="Voltrix" loading="eager" class="vx-header__logo-img">
    </a>
    <nav class="vx-header__nav">
      <a href="#formula">La fórmula</a>
      <a href="#porqué">Por qué Voltrix</a>
      <a href="#producto">El producto</a>
      <a href="#faq">Preguntas</a>
    </nav>
    <div class="vx-header__actions">
      <a href="#producto" class="vx-header__cta">Comprar — 44,99€</a>
    </div>
  </div>
</header>
<style>
  .vx-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    gap: 20px;
  }
  .vx-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .vx-header__logo-img {
    height: 26px;
    width: auto;
  }
  .vx-header__nav {
    display: flex;
    gap: 28px;
  }
  .vx-header__nav a {
    font-size: 13px;
    font-weight: 500;
    color: rgba(255,255,255,.55);
  }
  .vx-header__nav a:hover { color: var(--color-white); }
  .vx-header__cta {
    display: inline-flex;
    align-items: center;
    background: var(--color-volt);
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 800;
    padding: 9px 18px;
    border-radius: 8px;
    white-space: nowrap;
  }
  @media (max-width: 749px) {
    .vx-header__nav { display: none; }
  }
</style>
{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
